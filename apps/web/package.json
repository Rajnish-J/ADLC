{
  "name": "@sdlc/web",
  "version": "0.1.0",
  "private": true,
  "description": "SDLC platform web app (Next.js): projects, story board, members, agent catalog, workflow canvas and activity — the same backend the VS Code extension uses.",
  "license": "UNLICENSED",
  "scripts": {
    "build:packages": "tsc -b ../../packages/core ../../packages/contracts",
    "predev": "npm run build:packages && node scripts/copy-monaco.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "npm run build:packages && node scripts/copy-monaco.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "pretypecheck": "npm run build:packages",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.177",
    "@azure/msal-node": "^5.2.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@sdlc/contracts": "*",
    "@sdlc/core": "*",
    "@tanstack/react-table": "^9.3.1",
    "@xyflow/react": "^12.3.5",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "markdown-it": "^14.3.3",
    "monaco-editor": "^0.52.2",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.24.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.4.5"
  }
