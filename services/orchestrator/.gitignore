# Orchestrator service (Python). Only source, tests, pyproject.toml and uv.lock belong in git.

# Virtual environments (uv sync creates .venv here)
.venv/
venv/
env/
.python-version

# Compiled bytecode
__pycache__/
*.py[cod]
*$py.class

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.hypothesis/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Local settings and secrets
.env
.env.*
!.env.example

# Editors and OS
.idea/
.DS_Store
