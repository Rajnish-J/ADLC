# Local development settings. Copy to .env (git-ignored) to override; docker-compose.yml, the API and the web app
# read it. These defaults are for a database bound to 127.0.0.1 on your machine only — never reuse them elsewhere.

POSTGRES_USER=sdlc
POSTGRES_PASSWORD=sdlc_dev_password
POSTGRES_DB=sdlc
POSTGRES_PORT=5432

DATABASE_URL=postgres://sdlc:sdlc_dev_password@127.0.0.1:5432/sdlc

# ─── Sign-in ──────────────────────────────────────────────────────────────────────────────────────────────────
# `dev`: pick a seeded user (local development only — refused in production).
# `entra`: Microsoft Entra ID sign-in through MSAL. Fill in the app registration below.
AUTH_MODE=entra

# Entra ID app registration (Azure portal → Microsoft Entra ID → App registrations).
#   Redirect URI (platform "Web"): http://localhost:3000/api/auth/callback
#   Expose an API: Application ID URI api://<client id>, with a delegated scope named access_as_user
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Encrypts the web session cookie. Required in production: openssl rand -base64 32
AUTH_SESSION_SECRET=

# Optional overrides:
# ENTRA_API_SCOPE=api://<client id>/access_as_user          # the scope the web app requests for the API
# ENTRA_API_AUDIENCE=api://sdlc-api                          # extra audiences the API accepts (comma-separated)
# ENTRA_REDIRECT_URI=https://sdlc.example.com/api/auth/callback  # when the app runs behind a proxy

# Chat (Azure OpenAI): environment variables of the API process. Unset = the Chat page says it is not configured.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# AZURE_DEPLOYMENT_NAME=gpt-5.6-sol
# CHAT_MODELS=[{"id":"gpt-5.6-sol","label":"GPT-5.6","contextWindow":400000}]
# CHAT_APPROVAL_SECRET=

# Orchestrator service (services/orchestrator, Python): owns the workflow/agent catalog and drives platform runs.
# The gateway (apps/api) calls it at ORCHESTRATOR_URL; both sides share ORCHESTRATOR_TOKEN (required in production).
ORCHESTRATOR_URL=http://127.0.0.1:4100
ORCHESTRATOR_TOKEN=dev-orchestrator-token
# Where the orchestrator calls the gateway back (memory capture when a run finishes).
API_URL=http://127.0.0.1:4000
# Active-time budget of a platform run, in minutes (time waiting on a person does not count).
# RUN_TIMEOUT_MINUTES=240
