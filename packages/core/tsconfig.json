{
  // Browser-safe and Node-safe: no `vscode`, no Node APIs. CommonJS output + declarations so every consumer can
  // use it — the extension (tsc with rootDir src, esbuild), the API (tsx) and the Next.js app. The DOM lib is
  // only for web-standard types both runtimes share (AbortSignal).
  "compilerOptions": {
    "composite": true,
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
